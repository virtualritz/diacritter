pkgname=diacritter-git
pkgver=r0.0000000
pkgrel=1
pkgdesc="Press-and-hold diacritic popup for Linux (macOS-style)"
arch=('x86_64')
url="https://github.com/virtualritz/diacritter"
license=('MIT')
depends=('gtk4' 'gtk4-layer-shell')
makedepends=('cargo' 'pkgconf' 'git')
provides=('diacritter')
conflicts=('diacritter')
install=diacritter.install
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/diacritter"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
    cd "$srcdir/diacritter"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$srcdir/diacritter"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release --workspace
}

check() {
    cd "$srcdir/diacritter"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo test --frozen --workspace
}

package() {
    cd "$srcdir/diacritter"

    install -Dm0755 target/release/diacritter "$pkgdir/usr/bin/diacritter"
    install -Dm0755 target/release/diacritterd "$pkgdir/usr/bin/diacritterd"
    install -Dm0755 target/release/diacritter-popup "$pkgdir/usr/bin/diacritter-popup"

    install -Dm644 dist/diacritter.service "$pkgdir/usr/lib/systemd/user/diacritter.service"
    install -Dm644 dist/diacritter-popup.service "$pkgdir/usr/lib/systemd/user/diacritter-popup.service"
    install -Dm644 dist/70-diacritter.rules "$pkgdir/usr/lib/udev/rules.d/70-diacritter.rules"

    install -dm755 "$pkgdir/usr/share/diacritter/locales"
    install -Dm644 data/locales/*.toml "$pkgdir/usr/share/diacritter/locales/"
    install -Dm644 data/config.default.toml "$pkgdir/usr/share/diacritter/config.default.toml"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
