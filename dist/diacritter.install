post_install() {
    echo ":: Reloading udev rules..."
    udevadm control --reload-rules 2>/dev/null || true

    echo ""
    echo ":: To enable diacritter (runs as your user, not root):"
    echo "   systemctl --user enable --now diacritter"
    echo "   systemctl --user enable --now diacritter-popup"
    echo ""
    echo ":: Your user must be in the 'input' group:"
    echo "   sudo usermod -aG input \$USER"
    echo "   (log out and back in)"
    echo ""
    echo ":: Set your locale:"
    echo "   diacritter set-locale it   # it, es, fr, de, pt"
}

post_upgrade() {
    echo ":: Reloading udev rules..."
    udevadm control --reload-rules 2>/dev/null || true

    echo ""
    echo ":: Restart the user services:"
    echo "   systemctl --user restart diacritter diacritter-popup"
}

pre_remove() {
    echo ":: Disable the user services:"
    echo "   systemctl --user disable --now diacritter diacritter-popup"
}
