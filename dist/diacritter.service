[Unit]
Description=Press-and-hold diacritic daemon
After=default.target

[Service]
Type=simple
ExecStart=/usr/bin/diacritterd
Restart=on-failure
RestartSec=3
RuntimeDirectory=diacritter
# The daemon runs in the user session and only needs /dev/input and /dev/uinput.
# Namespace-based hardening (ProtectHome, ProtectSystem, PrivateTmp) is omitted
# because Ubuntu restricts unprivileged user namespaces by default.
NoNewPrivileges=yes

[Install]
WantedBy=default.target
